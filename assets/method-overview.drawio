  <diagram id="editing-notes" name="Editing guide">
    <mxGraphModel dx="1768" dy="881" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="guide_root" />
        <mxCell id="guide_layer" parent="guide_root" />
        <mxCell id="guide_note_0" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=32;fontStyle=1;strokeColor=none;fillColor=none;" value="Editing guide" vertex="1">
          <mxGeometry height="60" width="1020" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_1" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=23;fontStyle=1;strokeColor=none;fillColor=none;" value="Source reference" vertex="1">
          <mxGeometry height="35" width="1020" x="40" y="128" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_2" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=19;fontStyle=0;strokeColor=none;fillColor=none;" value="Base: FlowVN MRI Reconstruction Workflow; 1916 × 821 px.&lt;br&gt;Public inputs: analytic schematics, with the approved axes, layout, and T2 → S1 detour." vertex="1">
          <mxGeometry height="65" width="1020" x="40" y="176" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_3" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=23;fontStyle=1;strokeColor=none;fillColor=none;" value="Native editable elements" vertex="1">
          <mxGeometry height="35" width="1020" x="40" y="267" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_4" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=19;fontStyle=0;strokeColor=none;fillColor=none;" value="112 main-page text objects, panel gradients, chart bars, and connectors remain native.&lt;br&gt;All text uses Arial, with separate heading, label, and note sizes; no stretched glyphs.&lt;br&gt;The complex icons remain raster crops; the nine input tiles are analytic schematics." vertex="1">
          <mxGeometry height="91" width="1020" x="40" y="315" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_5" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=23;fontStyle=1;strokeColor=none;fillColor=none;" value="Individually replaceable image assets" vertex="1">
          <mxGeometry height="35" width="1020" x="40" y="433" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_6" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=19;fontStyle=0;strokeColor=none;fillColor=none;" value="Nine input tiles reuse four independent, data-free illustrations; no measured data is embedded.&lt;br&gt;K-space: an analytic Fourier envelope on chosen Cartesian PE lines, one encoding/frame.&lt;br&gt;Coils: smooth analytic magnitude fields on a shared 0–1 scale; N&lt;sub&gt;c&lt;/sub&gt; is generic." vertex="1">
          <mxGeometry height="91" width="1020" x="40" y="481" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_7" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=23;fontStyle=1;strokeColor=none;fillColor=none;" value="Replacing data" vertex="1">
          <mxGeometry height="35" width="1020" x="40" y="599" as="geometry" />
        </mxCell>
        <mxCell id="guide_note_8" parent="guide_layer" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#102D4D;fontSize=19;fontStyle=0;strokeColor=none;fillColor=none;" value="k&lt;sub&gt;x&lt;/sub&gt; = FE (right); k&lt;sub&gt;y&lt;/sub&gt; = PE (up). The single axis pair applies to all k-space tiles.&lt;br&gt;Coil maps have no cardiac-time or flow-encoding axis; N&lt;sub&gt;c&lt;/sub&gt; counts receive channels.&lt;br&gt;The k-space and coil illustrations are independent analytic shapes, not measured paired slices.&lt;br&gt;Select a tile and replace its image. Labels and axes remain separate native objects." vertex="1">
          <mxGeometry height="115" width="1020" x="40" y="647" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
